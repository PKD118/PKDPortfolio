# Copy to .env (gitignored) and fill in. Never commit real values.
# EXPO_PUBLIC_* are inlined into the JS bundle (safe for non-secret client config only).

# --- Service adapter modes: "mock" | "live"/"real" ---
# API_MODE = Express backend (AI meal/workout/swap). Firestore logged data = DATA_MODE below.
EXPO_PUBLIC_API_MODE=live
EXPO_PUBLIC_AUTH_MODE=real
# Logged data (workouts/meals/nutrition) + calendar schedule — both Firestore-owned, real by
# default (sit next to real Auth). Needs the firestore native pod (dev-client rebuild). mock = offline.
EXPO_PUBLIC_DATA_MODE=real
EXPO_PUBLIC_SCHEDULE_MODE=real
# Exercise demo videos stream from Firebase Storage (exercise-videos/{id}.mp4). Needs the
# @react-native-firebase/storage native module → requires a dev-client rebuild (not Expo Go).
EXPO_PUBLIC_STORAGE_MODE=real
EXPO_PUBLIC_COACH_UI=1

# --- Backend (local Express). Simulator: localhost; physical device: Mac LAN IP ---
EXPO_PUBLIC_API_BASE_URL=https://genfit-backend-gn7omflpdq-uc.a.run.app/api
# Food search / barcode / photo scan — mock until backend /v1/food/* ships (independent of API_MODE)
EXPO_PUBLIC_FOOD_API_MODE=mock

# --- Firebase Auth (Google sign-in). Only needed when AUTH_MODE=real ---
# Google "Web client" OAuth ID: Firebase console → Authentication → Google provider → Web SDK config
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=295208799701-n6tjau1j6hep8u1kbntu0po1ff1vp8c9.apps.googleusercontent.com

# --- RevenueCat public SDK keys (per platform). Only needed when BILLING_MODE=real ---
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=

FIREBASE_TOKEN=1//0gvufLAnC3K3gCgYIARAAGBASNwF-L9IrTO8b_T0gnVysBILa7YfxGycXtKrDCHVfQ3AE7Jej8K_qR9qVy2lAiZdaShb6R2AN_MU

# --- Store legal pages (Firebase Hosting — npm run legal:deploy, see legal/README.md) ---
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://gen-fit-ca5d4.web.app/legal/privacy.html
EXPO_PUBLIC_TERMS_URL=https://gen-fit-ca5d4.web.app/legal/terms.html

# --- EAS / build (CI only; not inlined) ---
EAS_PROJECT_ID=5ebfa252-1188-4dca-a979-cf316cd7476a

# Firebase config files are injected as EAS file secrets at build time, never committed:
#   GoogleService-Info.plist (iOS) and google-services.json (Android)

TRELLO_API_KEY=e017e1e965d23b9f856a0d8692ddfe42
