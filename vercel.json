{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/v1",
      "destination": "REPLACE_WITH_OLD_DEPLOYMENT_URL"
    },
    {
      "source": "/v1/:path*",
      "destination": "REPLACE_WITH_OLD_DEPLOYMENT_URL/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
